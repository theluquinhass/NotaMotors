# Copie para .env (o .env não vai para o git).
# Credenciais só do Postgres local do docker-compose.yml.

# API: usuário sem privilégios, sempre sujeito ao RLS.
DATABASE_URL=postgres://notamotors_app:notamotors_app@localhost:5432/notamotors
# Migrações e administração: dono das tabelas.
DATABASE_ADMIN_URL=postgres://notamotors:notamotors@localhost:5432/notamotors

# Mesmos papéis no banco de testes (apagado e recriado a cada `pnpm test`).
DATABASE_URL_TEST=postgres://notamotors_app:notamotors_app@localhost:5432/notamotors_test
DATABASE_ADMIN_URL_TEST=postgres://notamotors:notamotors@localhost:5432/notamotors_test
